{
  "name": "dsh-pdf-jump",
  "version": "0.1.5",
  "description": "在 DSH 侧栏里看本地 PDF：跳到任意一页，整本连着看。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./native": "./native.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "native.js",
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-0 <0.2.3-0"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.13",
    "pdfjs-dist": "6.4.299"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pdf",
    "viewer",
    "page-number",
    "manual"
  ],
  "scripts": {
    "smoke": "node scripts/smoke.mjs"
  },
  "author": "taoziliyouchong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/taoziliyouchong/dsh-pdf-jump"
  },
  "homepage": "https://github.com/taoziliyouchong/dsh-pdf-jump#readme",
  "bugs": {
    "url": "https://github.com/taoziliyouchong/dsh-pdf-jump/issues"
  }
}
